# ============================================================
# 11-1-depcheck-live · .gitignore
# 交付面 = Node 24 零依赖 ESM（见 plan/00 §2.1）。下方 Python 段是初始模板残留，
#   留着无害（本仓不产出这些路径），**别据此推断本项目有 Python 交付面**。
#   · node_modules/  —— 基准语料所需依赖由 fixtures 现装，不入库
#   · _private/      —— 本地核对材料
#   · .depcheck-live/ —— 工具自身缓存
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 虚拟环境
.venv/
venv/
ENV/
env/
.python-version

# 测试与覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# ---------- Node（本工具的被测对象，不是本工具的依赖）----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 本项目 ----------
_private/
.depcheck-live/
tmp/
*.tmp
# 迭代交接物（诊断/执行对话落盘）：只留本地、永不入库，内容天然含本机绝对路径。
# 与 tools/check-desensitized.mjs 的 SKIP_DIRS 同笔配对（gate-selfcheck 逐条对账）。
update/
# 发布附件（M6 口径 A：整个 tag 树的 zip）。产物不入库——它由 tag 树生成，
# 入库会让"附件"与"tag 树"成为两份可能漂移的副本。sha256 记在 plan/RELEASE-M6.md。
dist-release/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- 例外：以下必须入库 ----------
!fixtures/**/INPUT.md
!fixtures/**/expected.json
!data/README.md
!plan/*.md
!docs/**/*.md
!docs/demo/*.gif

# ---------- 工具自身的 hook 状态（不是交付面） ----------
.mimosa/
