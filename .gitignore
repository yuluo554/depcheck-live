# ============================================================
# 11-1-depcheck-live · .gitignore
# Python 标准模板 + 本项目特有排除项
#   · node_modules/  —— 基准语料所需的依赖由 fixtures 的 setup 脚本现装，不入库
#   · _private/      —— 本地核对材料
#   · .depcheck-live/ —— 工具自身缓存
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 虚拟环境
.venv/
venv/
ENV/
env/
.python-version

# 测试与覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# ---------- Node（本工具的被测对象，不是本工具的依赖）----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 本项目 ----------
_private/
.depcheck-live/
tmp/
*.tmp

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- 例外：以下必须入库 ----------
!fixtures/**/INPUT.md
!fixtures/**/expected.json
!data/README.md
!plan/*.md
!docs/**/*.md
!docs/demo/*.gif