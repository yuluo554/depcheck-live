  },
  "points": [
    {
      "id": "c4-1",
      "file": "src/a.cjs",
      "line": 3,
      "kind": "require",
      "specifier": "chalk/package.json",
      "imported": [],
      "status": "NOT-EXPORTED-SUBPATH",
      "evidence": {
        "rule": "data/README.md §5 形态③（未列该子路径）",
        "exportsSnippet": "\"exports\": { \"types\": \"./source/index.d.ts\", \"default\": \"./source/index.js\" }",
        "exportsKeys": [
          "."
